            print(f"Local file keys: {list(scan_data.keys())}")

            # Try to extract scan_uuid (FCS uses scan_uuid, not scan_id)
            scan_id = scan_data.get("scan_uuid") or scan_data.get("scan_id") or scan_data.get("id")
            if scan_id:
                print(f"Found scan UUID: {scan_id}")

            # Parse findings from local file
            findings = parse_fcs_scan_results(scan_data)
            print(f"Found {len(findings)} findings in local file")

            # Debug: show detection summary if present
            if "detection_summary" in scan_data:
                summary = scan_data["detection_summary"]
                print(f"Detection summary: {summary}")
        except Exception as e:
            print(f"Error reading local file: {e}")

    # Try CrowdStrike API if no findings
    if len(findings) == 0:
        print("🌐 Fetching from CrowdStrike API...")
        client_id = os.environ.get("FALCON_CLIENT_ID") or os.environ.get("CS_CLIENT_ID")
        client_secret = os.environ.get("FALCON_CLIENT_SECRET") or os.environ.get("CS_CLIENT_SECRET")
        region = os.environ.get("FALCON_REGION", "us-1")

        if client_id and client_secret:
            token, base_url = get_falcon_oauth_token(client_id, client_secret, region)
            if token:
                print("✅ Successfully authenticated to CrowdStrike API")
                findings = get_iac_detections_from_api(token, base_url, scan_id)
                print(f"📊 Fetched {len(findings)} detections from API")
            else:
                print("❌ Failed to authenticate to CrowdStrike API")
        else:
            print("⚠️ Missing FALCON_CLIENT_ID or FALCON_CLIENT_SECRET")

    # Count severities
    severity_counts = Counter()
    for finding in findings:
        # Handle different severity field names
        severity = (finding.get("severity") or
                   finding.get("Severity") or
