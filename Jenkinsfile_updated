def get_falcon_oauth_token(client_id, client_secret, region):
    """Get OAuth2 token from CrowdStrike"""
    base_urls = {
        "us-1": "https://api.crowdstrike.com",
        "us-2": "https://api.us-2.crowdstrike.com",
        "eu-1": "https://api.eu-1.crowdstrike.com"
    }
    base_url = base_urls.get(region, "https://api.crowdstrike.com")

    url = f"{base_url}/oauth2/token"
    data = f"client_id={client_id}&client_secret={client_secret}".encode()

    try:
        req = urllib.request.Request(url, data=data, method="POST")
        req.add_header("Content-Type", "application/x-www-form-urlencoded")
        with urllib.request.urlopen(req, timeout=30) as response:
            result = json.loads(response.read().decode())
            return result.get("access_token"), base_url
    except Exception as e:
        print(f"Failed to get OAuth token: {e}")
        return None, base_url

def get_iac_detections_from_api(token, base_url, scan_id=None):
    """Fetch IaC detections from CrowdStrike API"""
    if not token:
        return []

    # Build URL with optional scan_id filter
    url = f"{base_url}/iac/combined/detections/v1?limit=500"
    if scan_id:
        url += f"&scan_id={scan_id}"

    try:
        req = urllib.request.Request(url, method="GET")
        req.add_header("Authorization", f"Bearer {token}")
        with urllib.request.urlopen(req, timeout=30) as response:
            result = json.loads(response.read().decode())
            detections = result.get("resources", [])
            print(f"API Response: {len(detections)} resources")
            if detections:
                print(f"First detection keys: {list(detections[0].keys())}")
            return detections
    except urllib.error.HTTPError as e:
        print(f"HTTP Error {e.code}: {e.read().decode()}")
        return []
    except Exception as e:
        print(f"Failed to fetch IaC detections from API: {e}")
        return []

def parse_fcs_scan_results(scan_data):
    """Parse FCS scan results format"""
    findings = []

    # FCS CLI format uses 'rule_detections'
    if "rule_detections" in scan_data:
        findings = scan_data.get("rule_detections", [])
    elif "detections" in scan_data:
        findings = scan_data.get("detections", [])
    elif "resources" in scan_data:
        findings = scan_data.get("resources", [])
    elif "findings" in scan_data:
        findings = scan_data.get("findings", [])
    elif "vulnerabilities" in scan_data:
        findings = scan_data.get("vulnerabilities", [])

    return findings

