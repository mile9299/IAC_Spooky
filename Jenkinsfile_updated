<div class="powered-by">Powered by CrowdStrike Threat Intelligence | © 2026 CrowdStrike, Inc.</div>
</div>
</div></body></html>"""

with open("image_assessment_report.html", "w") as f:
    f.write(html)
print("✅ Image Report generated")
