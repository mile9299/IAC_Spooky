// Jenkinsfile for CrowdStrike IaC Security Scanning with Jenkins-Styled Reports
pipeline {
    agent any

    environment {
        FALCON_CLIENT_ID     = credentials('crowdstrike-client-id')
        FALCON_CLIENT_SECRET = credentials('crowdstrike-client-secret')
        SCAN_RESULTS_JSON    = 'fcs_iac_scan_results_latest.json'
        REPORT_HTML          = 'fcs_iac_latest_report.html'
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out source code...'
                checkout scm
            }
        }

        stage('Run IaC Security Scan') {
            steps {
                echo 'Running CrowdStrike IaC Security Scan...'
                script {
                    // Your IaC scanning logic here
                    // This should generate: fcs_iac_scan_results_latest.json
                    sh '''
                        # Example: Run your scan script that outputs JSON results
                        python3 falcon_iac_scan_wrapper.py
                    '''
                }
            }
        }

        stage('Generate HTML Report') {
            steps {
                echo 'Generating Jenkins-styled HTML report...'
                sh '''
                    # Generate the report using the bash wrapper
                    ./generate_iac_report.sh "${SCAN_RESULTS_JSON}" "${REPORT_HTML}"
                '''
            }
        }

        stage('Publish Report') {
            steps {
                echo 'Publishing CrowdStrike Security Report...'
                publishHTML([
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: '.',
                    reportFiles: "${REPORT_HTML}",
                    reportName: 'CrowdStrike IaC Security Report',
                    reportTitles: 'Security Scan Results'
                ])
            }
        }

        stage('Analyze Results') {
            steps {
                script {
                    // Parse the JSON to check severity counts
                    def scanResults = readJSON file: "${SCAN_RESULTS_JSON}"
                    def criticalCount = 0
                    def highCount = 0

                    scanResults.each { finding ->
                        def severity = finding.rule.severity
                        if (severity == 3) criticalCount++
                        else if (severity == 2) highCount++
                    }

                    echo "Scan Summary:"
                    echo "  Total Violations: ${scanResults.size()}"
                    echo "  Critical: ${criticalCount}"
                    echo "  High: ${highCount}"

                    // Optional: Fail build if critical violations found
                    if (criticalCount > 0) {
                        unstable(message: "Found ${criticalCount} critical security violations")
                    }
                }
            }
        }
    }

    post {
        always {
            echo 'Archiving scan results and report...'
            archiveArtifacts artifacts: "${SCAN_RESULTS_JSON},${REPORT_HTML}", fingerprint: true
        }

        success {
            echo 'Pipeline completed successfully!'
            echo "View the security report at: ${env.BUILD_URL}CrowdStrike_IaC_Security_Report/"
        }

        failure {
            echo 'Pipeline failed!'
        }

        unstable {
            echo 'Pipeline unstable due to security violations'
            emailext(
                subject: "Security Violations Found in ${env.JOB_NAME} - Build ${env.BUILD_NUMBER}",
                body: """
                    Security scan detected violations in build ${env.BUILD_NUMBER}.

                    View the detailed report at:
                    ${env.BUILD_URL}CrowdStrike_IaC_Security_Report/

                    This is an automated message from Jenkins.
                """,
                to: '${DEFAULT_RECIPIENTS}'
            )
        }
    }
}
